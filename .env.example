APP_NAME=musicapp
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT=15
APP_WRITE_TIMEOUT=15
APP_IDLE_TIMEOUT=60
APP_SHUTDOWN_TIMEOUT=10

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/musicapp?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=debug

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
MEDIA_BASE_PATH=/var/www/music/media
MEDIA_PUBLIC_BASE=https://yourdomain.com/media
MEDIA_MAX_FILE_SIZE_MB=30
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_AUDIO_SIZE_MB=30


STORAGE_DRIVER=local
STORAGE_LOCAL_BASE_DIR=uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/uploads

# S3 / MinIO (local dev). Override these for production S3.
# STORAGE_DRIVER=s3
# S3_BUCKET=music-media
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio123
# S3_PUBLIC_BASE_URL=http://localhost:9000/music-media
# S3_USE_PATH_STYLE=true
# S3_PRESIGN_URLS=false
# S3_PRESIGN_TTL_SECONDS=900

# Enrichment (ingestion) — at least one is needed to auto-fill artist bios, images, etc.
# MusicBrainz works without any API key (rate-limited on public API).
# Last.fm / Spotify:
# LASTFM_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
