# ═══════════════════════════════════════════════════════════════════════
# Moja ML Service — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# ── App ────────────────────────────────────────────────────────────────
# APP_NAME         Name of the service, used in logging and metrics.
# ENVIRONMENT      One of: development | staging | production
# DEBUG            Enable SQLAlchemy echo and verbose logging (true/false).
APP_NAME=moja-ml-service
ENVIRONMENT=development
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────
# DATABASE_URL     Postgres connection string for this service's OWN database.
#                  This is separate from the Go catalog database.
#                  Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://moja_ml:changeme_in_production@localhost:5433/moja_ml

# ── Redis / Celery ─────────────────────────────────────────────────────
# REDIS_URL                General-purpose Redis connection (caching, rate-limits).
# CELERY_BROKER_URL        Redis DB used as Celery task broker (recommend: DB 1).
# CELERY_RESULT_BACKEND    Redis DB used for Celery task result storage (DB 2).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Storage Mode ───────────────────────────────────────────────────────
# STORAGE_MODE      How this service accesses audio files:
#                   "shared_volume" — Go's uploads directory is mounted into
#                     this container. The job payload contains audio_file_path.
#                   "presigned_url" — Go generates a presigned S3 download URL
#                     and passes it in the job payload. No credentials needed here.
# AUDIO_SHARED_PATH Path where audio files are mounted (only used when
#                   STORAGE_MODE=shared_volume). In docker-compose, mount
#                   the Go uploads directory here.
STORAGE_MODE=shared_volume
AUDIO_SHARED_PATH=/mnt/audio-uploads

# ── Whisper (faster-whisper) ───────────────────────────────────────────
# WHISPER_MODEL_SIZE       Model size: tiny | base | small | medium | large-v3
# WHISPER_COMPUTE_TYPE     Compute type for CPU inference: int8 | float16 | float32
#                         int8 is fastest on CPU with negligible quality loss.
# WHISPER_DEVICE           Always "cpu" for our deployment target (no GPU).
# WHISPER_LANGUAGE_HINT    Default language hint for transcription ("fa" for Persian).
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE_HINT=fa

# ── Go Backend Callback ────────────────────────────────────────────────
# GO_BACKEND_CALLBACK_URL  Base URL of the Go backend's internal API.
#                          This service POSTs results back here.
#                          Example: http://moja-api:8080/api/v1
# WEBHOOK_HMAC_SECRET      Shared secret used to HMAC-sign webhook payloads
#                          so the Go backend can verify authenticity.
GO_BACKEND_CALLBACK_URL=http://moja-api:8080/api/v1
WEBHOOK_HMAC_SECRET=change-me-to-a-random-secret
