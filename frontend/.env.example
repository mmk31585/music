# API base URL (WITHOUT trailing slash)
# ❌ https://api.example.com/
# ✅ https://api.example.com
VITE_API_BASE_URL=

# Admin credentials (example)
# Note: in Vite, only variables starting with VITE_ are exposed to the client bundle.
VITE_ADMIN_USER_NAME=
VITE_ADMIN_PASSWORD=
VITE_ARCHIVE_TABS_PERSIST=