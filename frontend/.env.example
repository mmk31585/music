# ════════════════════════════════════════════════════════════
# Muse Frontend — Environment Variables
# ════════════════════════════════════════════════════════════
# Only variables prefixed with VITE_ are exposed to the client.
# ════════════════════════════════════════════════════════════

# API base URL (WITHOUT trailing slash)
# Production (Vercel): full URL to your Go backend (e.g., https://api.museapp.com/api/v1)
# Local dev: relative path (/api/v1) — Vite proxy handles forwarding to :8080
VITE_API_BASE_URL=/api/v1

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000

# WebSocket URL
# Production (Vercel): wss://api.museapp.com/api/v1/ws
# Local dev: ws://localhost:8080/api/v1/ws
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Maintenance mode (optional)
# VITE_IN_MAINTENANCE_MODE=false
# VITE_IN_MAINTENANCE_MODE_CODE=
