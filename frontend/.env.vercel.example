# ════════════════════════════════════════════════════════════
# Vercel Environment Variables for Muse Frontend
# ════════════════════════════════════════════════════════════
# Set these in Vercel Dashboard: Project Settings → Environment Variables
# For local dev, copy to .env or use .env.production
# ════════════════════════════════════════════════════════════

# Your Go backend URL (deployed on Railway, Fly.io, VPS, etc.)
# No trailing slash!
VITE_API_BASE_URL=https://api.museapp.com/api/v1

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000

# WebSocket URL for real-time features (player sync, rooms, notifications)
VITE_WS_URL=wss://api.museapp.com/api/v1/ws

# Optional: Maintenance mode
# VITE_IN_MAINTENANCE_MODE=false
# VITE_IN_MAINTENANCE_MODE_CODE=
