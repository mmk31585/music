{
  "version": 2,
  "framework": "go",
  "buildCommand": "go build -o bin/api ./cmd/api",
  "outputDirectory": "bin",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/swagger/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/(.*)",
      "dest": "/bin/api"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_HOST": "0.0.0.0",
    "APP_PORT": "3000",
    "APP_READ_TIMEOUT": "15s",
    "APP_WRITE_TIMEOUT": "15s",
    "APP_IDLE_TIMEOUT": "60s",
    "APP_SHUTDOWN_TIMEOUT": "10s",
    "LOG_LEVEL": "info",
    "DATABASE_SOURCE": "${POSTGRES_URL_NON_POOLING}",
    "REDIS_ADDR": "redis:6379",
    "POSTGRES_URL": "${POSTGRES_URL_NON_POOLING}",
    "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
    "POSTGRES_DATABASE": "${POSTGRES_DATABASE}",
    "POSTGRES_HOST": "${PGHOST}",
    "POSTGRES_USER": "${PGUSER}",
    "CORS_ALLOWED_ORIGINS": "https://your-frontend.vercel.app,https://localhost:3000"
  },
  "crons": [
    {
      "path": "/api/v1/cron/sync",
      "schedule": "0 2 * * *"
    }
  ]
}
