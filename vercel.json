{
  "version": 2,
  "framework": "go",
  "buildCommand": "wget -q -O bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux && chmod +x bin/yt-dlp && go build -o bin/api ./cmd/api",
  "outputDirectory": "bin",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/swagger/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/bin/api"
    },
    {
      "src": "/(.*)",
      "dest": "/bin/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/sync",
      "schedule": "0 2 * * *"
    }
  ]
}
