{
  "title": "MusicApp Workers",
  "uid": "musicapp-workers",
  "description": "Background worker monitoring dashboard",
  "timezone": "browser",
  "panels": [
    {
      "title": "Worker Runs (rate)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(music_worker_runs_total[5m])) by (worker)",
          "legendFormat": "{{worker}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Worker Error Rate",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(music_worker_runs_total{status=\"error\"}[5m])) by (worker)",
          "legendFormat": "{{worker}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Worker Run Duration (p95)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(music_worker_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Worker Success Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(music_worker_runs_total{status=\"success\"}[5m])) / sum(rate(music_worker_runs_total[5m])) * 100",
          "legendFormat": "success %"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
